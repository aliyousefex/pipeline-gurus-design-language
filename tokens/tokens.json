{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "black": { "$type": "color", "$value": "#000000" },
    "white": { "$type": "color", "$value": "#FFFFFF" },
    "actionRed": { "$type": "color", "$value": "#F6283F" },
    "softWhite": { "$type": "color", "$value": "#F5F5F3" },
    "muted": { "$type": "color", "$value": "#A7A7A7" },
    "textDark": { "$type": "color", "$value": "#333333" },
    "lineDark": { "$type": "color", "$value": "#303030" },
    "lineLight": { "$type": "color", "$value": "#D7D7D7" },
    "textLight": { "$type": "color", "$value": "#D0D0D0" }
  },
  "fontFamily": {
    "display": { "$type": "fontFamily", "$value": ["Bebas Neue", "Arial Narrow", "sans-serif"] },
    "body": { "$type": "fontFamily", "$value": ["Poppins", "Arial", "sans-serif"] }
  },
  "radius": {
    "default": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "cta": { "$type": "dimension", "$value": { "value": 10, "unit": "px" } }
  },
  "grid": {
    "columns": { "$type": "number", "$value": 12 },
    "socialSquare": { "$type": "dimension", "$value": { "value": 1080, "unit": "px" } },
    "columnWidth": { "$type": "dimension", "$value": { "value": 90, "unit": "px" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 500, "unit": "ms" } },
    "slow": { "$type": "duration", "$value": { "value": 1000, "unit": "ms" } }
  }
}
